# Copy to tests/integration/.env and fill in sandbox credentials.
# These are NOT production values — use a dedicated test workspace/guild.

# --- Slack sandbox ---
SLACK_BOT_TOKEN=xoxb-your-sandbox-bot-token
SLACK_SIGNING_SECRET=your-sandbox-signing-secret
SLACK_TEST_CHANNEL=C0123TEST

# --- Discord sandbox ---
DISCORD_BOT_TOKEN=your-sandbox-bot-token
DISCORD_PUBLIC_KEY=hex-encoded-public-key
DISCORD_APPLICATION_ID=000000000000000000
DISCORD_TEST_CHANNEL=000000000000000000
DISCORD_TEST_GUILD=000000000000000000
# Private key is needed to forge valid signatures against the endpoint:
DISCORD_PRIVATE_KEY=hex-encoded-64-byte-ed25519-seed

# --- Deployed stack ---
WEBHOOK_BASE_URL=https://abcdef1234.execute-api.us-west-2.amazonaws.com/dev
AWS_REGION=us-west-2
STAGE=dev
