# Local-dev fallback config for `npm run dev`. In a deployed build these values
# come from /config.json (written by the deploy step in Phase 5), so this file
# is only for running the SPA against a real dev stack from your laptop.
#
# Copy to `.env.local` and fill in from the foundation stack outputs:
#   DashboardApiEndpoint      -> VITE_API_BASE_URL
#   DashboardUserPoolId       -> derive the authority (see below)
#   DashboardUserPoolClientId -> VITE_COGNITO_CLIENT_ID
#   DashboardLoginDomain      -> VITE_COGNITO_LOGIN_DOMAIN
#
# The OIDC authority is the user pool's issuer URL:
#   https://cognito-idp.<region>.amazonaws.com/<UserPoolId>

VITE_API_BASE_URL=https://example.execute-api.us-west-2.amazonaws.com/dev
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_LOGIN_DOMAIN=https://sdlc-agents-dash-000000000000-dev.auth.us-west-2.amazoncognito.com
VITE_REDIRECT_URI=http://localhost:5173/
