FROM python:3.12-slim@sha256:46cb7cc2877e60fbd5e21a9ae6115c30ace7a077b9f8772da879e4590c18c2e3

RUN groupadd --system --gid 1001 agent \
 && useradd --system --uid 1001 --gid agent --no-create-home --shell /sbin/nologin agent

WORKDIR /app

# Base requirements (the common set every config-driven agent needs). Per-agent
# requirements from the capability config are layered on by the buildspec via a
# generated requirements-extra.txt — pip install -r handles both.
COPY _base/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Layer per-agent extra deps (generated by the buildspec from capability config).
# The file may be empty but must exist — the buildspec creates it.
COPY _base/requirements-extra.txt .
RUN pip install --no-cache-dir -r requirements-extra.txt

COPY --chown=agent:agent shared/ /app/shared/
COPY --chown=agent:agent _base/agent.py /app/

# Skills directory — the deployer syncs referenced S3 skill packages here before
# start (P4). Empty until skills are attached.
RUN mkdir -p /app/skills && chown agent:agent /app/skills

EXPOSE 8080

USER agent

CMD ["opentelemetry-instrument", "python", "agent.py"]
